# Copy to .env (start.sh does it for you) and adjust. Every value has a
# working default; nothing here is required to bring the stack up.

# --- Ports on the host -------------------------------------------------------
# Speckle's web UI. Port 80 is the default because Speckle bakes its origin
# into the frontend bundle at runtime; if you change this, SPECKLE_ORIGIN must
# match, and the two must agree or the frontend will call a server that is not
# there.
SPECKLE_PORT=80
SPECKLE_ORIGIN=http://127.0.0.1

CONNECT_PORT=3000       # Connect (the editors and drive apps)
SWITCHBOARD_PORT=4001   # Switchboard (GraphQL, analytics, subgraphs, MCP)
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000         # must stay reachable from the browser: uploads go here
MINIO_CONSOLE_PORT=9001
MAILDEV_UI_PORT=1080    # only with `--profile debug`
MAILDEV_SMTP_PORT=1025

# --- Postgres ----------------------------------------------------------------
# One role, two databases: `speckle` (created by the image) and `powerhouse`
# (created by docker/postgres-init.sql on first start).
POSTGRES_USER=speckle
POSTGRES_PASSWORD=speckle
POSTGRES_DB=speckle

# --- Speckle -----------------------------------------------------------------
SPECKLE_TAG=2.31.14
SPECKLE_SESSION_SECRET=local-dev-secret-change-me
SPECKLE_FILE_SIZE_LIMIT_MB=1000

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- The sync runner's credential --------------------------------------------
# A Speckle personal access token, created under Profile -> Access Tokens once
# you have registered an account. Scopes: streams:read, users:read.
#
# This is a *service* credential for the server-side runner. It is deliberately
# not the token a collaborator stores in a sync document's local scope — that
# one stays private to them and never reaches the server.
SPECKLE_TOKEN=
